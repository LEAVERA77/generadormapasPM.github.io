<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_export" />

        <TextView
            android:id="@+id/tvExportCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="—" />

        <TextView
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_format" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radioCsv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/format_csv" />

            <RadioButton
                android:id="@+id/radioKml"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_kml" />

            <RadioButton
                android:id="@+id/radioGpx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_gpx" />

            <RadioButton
                android:id="@+id/radioGeojson"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_geojson" />

            <RadioButton
                android:id="@+id/radioDxf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format_dxf" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvExportCrs"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="—" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/export_and_share" />

    </LinearLayout>
</ScrollView>
